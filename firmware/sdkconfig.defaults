CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 8 MB octal PSRAM; the two 800x480 RGB565 frame buffers live there.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000

# RGB LCD: keep the DMA fed from internal RAM while Wi-Fi is busy.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=y
CONFIG_GDMA_ISR_IRAM_SAFE=y

# Wi-Fi + plain HTTP to the hub on the LAN; generous buffers for the JSON body.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# LVGL 9 via Kconfig (no lv_conf.h). The simulator mirrors these in sim/lv_conf.h.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL's heap in PSRAM (src/lv_mem_psram.c): on plain malloc its small blocks, the glyph caches above all,
# went to internal RAM and left Wi-Fi a few KB of it.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_FILE_SUPPORT=n
CONFIG_LV_FONT_MONTSERRAT_14=y

CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n

# OTA: a freshly installed image boots in "pending verify" and is only kept once
# main.c has fetched the fleet; a reset before that rolls back to the old slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Logs over the USB-C port (the only serial connection on this board).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# app_main builds the whole LVGL screen (fonts, ~60 widgets); the 3.5 KB default overflowed once the header strip was added.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# GET /screenshot: the screen as LVGL drew it, for checking a build without standing at the panel.
CONFIG_LV_USE_SNAPSHOT=y
