; Copy to secrets.ini (git-ignored) and fill in. Every value is compiled in, so a
; change means a rebuild and a reflash (`pio run -t ota` once the board is on Wi-Fi).
[secrets]
; 2.4 GHz WPA2 network (the ESP32-S3 has no 5 GHz radio)
wifi_ssid = MyNetwork
wifi_password = MyPassword

; Where the hub listens (../hub, port 8767 by default): plain http on your LAN.
hub_url = http://192.0.2.10:8767

; The hub's device key: the contents of ~/.config/agent-control/device_key on the
; machine that runs the hub. It is also the password for this board's own pages
; (/ota, /screenshot, /tap, /leds).
device_key = paste-the-device-key-here

; The board's name on the network (DHCP and mDNS). `pio run -t ota` pushes to
; http://<hostname>.local/ unless OTA_HOST=<ip> is set in the environment.
hostname = agent-display

; The clock's time zone, as a POSIX TZ string. Examples:
;   UTC0                          UTC
;   GMT0BST,M3.5.0/1,M10.5.0      Europe/London
;   CET-1CEST,M3.5.0,M10.5.0/3    Europe/Paris, Berlin, Madrid
;   EST5EDT,M3.2.0,M11.1.0        America/New_York
;   PST8PDT,M3.2.0,M11.1.0        America/Los_Angeles
;   AEST-10AEDT,M10.1.0,M4.1.0/3  Australia/Sydney
timezone = UTC0

; 1 turns the picture and the touch input upside down, for a case or stand that
; holds the board with its USB sockets at the top.
rotate_180 = 0

; Optional: three WS2812B LEDs that light up in the colours of the three header
; counts (WORKING, NEEDS INPUT, DONE). -1 = no LEDs. GPIO 6 is the "AD" pin of the
; board's Sensor header, the one GPIO the board leaves free; power the strip from
; that header's 3V3 and GND. leds_reversed = 1 when the strip's first LED sits
; under the right-hand count rather than the left.
leds_gpio = -1
leds_reversed = 0
