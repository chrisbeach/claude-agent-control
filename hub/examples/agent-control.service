# A systemd user service for the hub. ../../install.sh installs it, with the path
# of your checkout. By hand: edit the path if you cloned elsewhere, then:
#   mkdir -p ~/.config/systemd/user
#   cp examples/agent-control.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agent-control
#   loginctl enable-linger "$USER"     # keep it running while you are logged out
#   journalctl --user -u agent-control -f
[Unit]
Description=Agent Control hub: live Claude Code sessions for the display
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/claude-agent-control/hub/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
